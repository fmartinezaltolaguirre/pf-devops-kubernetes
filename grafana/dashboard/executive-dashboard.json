{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "techwave",
    "executive",
    "kpi",
    "devops"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "TechWave Executive Dashboard",
  "uid": "techwave-executive-dashboard",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Availability",
      "description": "Overall platform availability",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(up) * 100"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLA Compliance",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "99.95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deployment Success Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "98"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Critical Incidents",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(ALERTS{severity=\"critical\",alertstate=\"firing\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Availability Trend",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "avg(up) * 100",
          "legendFormat": "Availability %"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Platform Performance Trend",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "Performance Index"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "DevOps Maturity Index",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
